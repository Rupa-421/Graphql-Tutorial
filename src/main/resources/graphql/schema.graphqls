type Query{
    users(page: Int =0 , size: Int = 10): UserPage
    user(id: ID!):User
}

type UserPage {
    content: [User]
    page: Int
    size: Int
    totalElements: Int
    totalPages: Int
    last: Boolean
}

type Mutation{
    createUser(input:CreateUserInput!): User
    deleteUser(id: ID!): User
}

type User{
    id: ID
    name: String
    email: String
}

input CreateUserInput{
    name: String!
    email: String!
}